      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "הקלטת פגישה / שיחה",
      "short_name": "פגישה",
      "description": "התחל הקלטת פגישה או שיחה — נשמרת בהקלטות",
