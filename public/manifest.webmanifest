      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "יומן",
      "short_name": "יומן",
      "description": "היומן והאירועים שלך",
      "url": "/app/calendar",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "משימות",
      "short_name": "משימות",
      "description": "רשימת המשימות שלך",
      "url": "/app/tasks",
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
